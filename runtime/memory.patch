+import { withGuardedFetchRequestAuthority } from "../infra/net/fetch-request-authority.js";
+import type {
+  AssistantMessage,
+  AssistantMessageEvent,
+  AssistantMessageEventStreamLike,
+} from "../llm/types.js";
+import { capturePluginStateReadDependencies } from "../plugin-state/plugin-state-publication.js";
+import type { PluginHookBeforePromptBuildResult } from "./hook-before-agent-start.types.js";
+import { withHookTimeout } from "./hook-timeout.js";
+
+/** Host custody of a registration's request-only reader; never a transcript value. */
+export type EphemeralPromptContext = {
+  read: NonNullable<PluginHookBeforePromptBuildResult["ephemeralContext"]>;
+  assertCurrent(): void;
+};
+
+export type PromptBuildHookDispatchResult = PluginHookBeforePromptBuildResult & {
+  ephemeralContexts?: EphemeralPromptContext[];
+};
+
+/** Reads stay live through provider consumption, including after other readers await. */
+export async function prepareEphemeralPromptContext(
+  context: EphemeralPromptContext,
+  assertHostCurrent: () => void,
+) {
+  let active = true;
+  const assertActive = () => {
+    if (!active) {
+      throw new Error("ephemeral prompt invocation is no longer active");
+    }
+    assertHostCurrent();
+    context.assertCurrent();
+  };
+  const pending = capturePluginStateReadDependencies(async () => {
+    assertActive();
+    const result = await context.read({ hookInvocation: Object.freeze({ assertActive }) });
+    assertActive();
+    return result &&
+      typeof result.text === "string" &&
+      typeof result.assertCurrent === "function" &&
+      Buffer.byteLength(result.text, "utf8") <= 4_096
+      ? result
+      : undefined;
+  });
+  try {
+    const captured = await withHookTimeout(pending, 2_000);
+    return {
+      // An old string/closure cache is insufficient: require a fresh tracked state read.
+      text: captured.dependencies.length ? captured.value?.text : undefined,
+      assertCurrent() {
+        assertActive();
+        captured.assertCurrent();
+        captured.value?.assertCurrent();
+      },
+      release() {
+        active = false;
+        captured.release();
+      },
+    };
+  } catch {
+    active = false;
+    // A timed-out reader may finish later; its result never reaches the request.
+    void pending.then(
+      (captured) => captured.release(),
+      () => {},
+    );
+    return undefined;
+  }
+}
+
+export type PreparedEphemeralPromptContext = NonNullable<
+  Awaited<ReturnType<typeof prepareEphemeralPromptContext>>
+>;
+
+/** Custody ends at producer terminal, rather than at the transport's early stream return. */
+export async function consumeEphemeralPromptContextRequest(input: {
+  entries: readonly PreparedEphemeralPromptContext[];
+  assertHostCurrent(): void;
+  start(
+    withMemory: boolean,
+  ): AssistantMessageEventStreamLike | Promise<AssistantMessageEventStreamLike>;
+  publish(event: AssistantMessageEvent): void;
+}): Promise<AssistantMessage> {
+  let sent = false;
+  let refused = false;
+  let published = false;
+  const assertMemoryCurrent = () => {
+    input.assertHostCurrent();
+    try {
+      for (const entry of input.entries) {
+        entry.assertCurrent();
+      }
+    } catch (error) {
+      refused = true;
+      throw error;
+    }
+  };
+  const consume = async (withMemory: boolean) => {
+    const source = await input.start(withMemory);
+    let pendingStart: AssistantMessageEvent | undefined;
+    for await (const event of source) {
+      // Terminal publication waits for the exact producer and its source scope to settle.
+      if (event.type === "done" || event.type === "error") {
+        continue;
+      }
+      if (withMemory && !sent) {
+        if (event.type === "start") {
+          pendingStart = event;
+          continue;
+        }
+        throw new Error("Memory transport emitted content without a final dispatch receipt");
+      }
+      if (pendingStart) {
+        input.publish(pendingStart);
+        pendingStart = undefined;
+      }
+      published = true;
+      input.publish(event);
+    }
+    return await source.result();
+  };
+  if (!input.entries.length) {
+    return consume(false);
+  }
+  let result: AssistantMessage;
+  try {
+    result = await withGuardedFetchRequestAuthority(
+      () => input.assertHostCurrent(),
+      () => consume(true),
+      undefined,
+      {
+        modelDispatch: {
+          version: 1,
+          assertCurrent: assertMemoryCurrent,
+          beforeEffect() {
+            // Only the host's model-send owner can call this, immediately before its effect.
+            sent = true;
+          },
+        },
+      },
+    );
+  } catch (error) {
+    if (!refused || sent || published) {
+      throw error;
+    }
+    // This frame is the original parent context: the private request scope has closed.
+    input.assertHostCurrent();
+    return consume(false);
+  }
+  if (refused && !sent && !published) {
+    input.assertHostCurrent();
+    return consume(false);
+  }
+  return result;
+}
