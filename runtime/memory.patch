+async function memoryGrant() {
+  const entry = { sessionId: randomUUID(), updatedAt: 1, chatType: "direct" as const };
+  fakeSessionOwner.rows.set(sessionKey, entry);
+  const grant = await resolveMemoryAudienceFromEntry(
+    {
+      agentId: "main",
+      sessionKey,
+      sessionId: entry.sessionId,
+      storePath: "/tmp/memory-reader.sqlite",
+    },
+    entry,
+  );
+  if (grant.status !== "granted") {
+    throw new Error(`Test audience refused: ${grant.reason}`);
+  }
+  onTestFinished(grant.release);
+  return {
+    memoryAudience: grant.audience,
+    assertMemoryAudienceCurrent: () => assertMemoryAudienceCurrent(grant.audience),
+  };
+}
